{
  "expo": {
    "name": "Advanced Terminal",
    "slug": "advanced-terminal",
    "scheme": "advterm",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#11111b",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.armen.advterm",
      "infoPlist": {
        "NSCameraUsageDescription": "Сканирование QR-кода сопряжения с приложением на Mac",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        },
        "ITSAppUsesNonExemptEncryption": false
      },
      "buildNumber": "1"
    },
    "android": {
      "package": "dev.armen.advterm",
      "adaptiveIcon": {
        "backgroundColor": "#11111b",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Сканирование QR-кода сопряжения"
        }
      ],
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "33460826-b1ad-45fb-b48d-44f122dc5e57"
      }
    },
    "owner": "armeny007"
  }
}
